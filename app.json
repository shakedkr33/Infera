{
  "expo": {
    "name": "InYomi",
    "slug": "inyomi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inyomi",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/inyomi-splash-logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shakedkr.inyomi",
      "buildNumber": "2",
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true,
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["whatsapp"]
      },
      "associatedDomains": ["applinks:inyomi.app"]
    },
    "android": {
      "package": "com.shakedkr.inyomi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "inyomi.app",
              "pathPrefix": "/shared/"
            },
            {
              "scheme": "https",
              "host": "inyomi.app",
              "pathPrefix": "/join/"
            },
            {
              "scheme": "https",
              "host": "inyomi.app",
              "pathPrefix": "/e/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-audio", "expo-font", "expo-router"],
    "owner": "shakedkr",
    "extra": {
      "eas": {
        "projectId": "1ebaed08-3c08-439c-9530-693eef771566"
      }
    }
  }
}
